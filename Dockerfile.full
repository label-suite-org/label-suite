FROM node:22-alpine AS revision
WORKDIR /source
RUN apk add --no-cache git
COPY . .
RUN sh scripts/write-build-revision.sh .release-revision

FROM node:22-alpine AS builder
WORKDIR /app
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=1
ARG DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV DATABASE_URL=$DATABASE_URL
ARG BETTER_AUTH_SECRET=build-only-secret-not-used-at-runtime-0123456789
ENV BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
COPY --from=revision /source/package.json /source/package-lock.json ./
RUN npm install --ignore-scripts
COPY --from=revision /source/ ./
RUN rm -rf .git
RUN npm run build

FROM node:22-alpine AS web
WORKDIR /app
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=1
COPY --from=builder /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --from=builder /app/dist/server ./server
COPY --from=builder /app/dist/client ./client
COPY --from=builder /app/.release-revision ./.release-revision
ENV NODE_ENV=production
ENV PORT=4321
ENV HOST=0.0.0.0
ENV APP_REVISION_FILE=/app/.release-revision
EXPOSE 4321
CMD ["node", "server/entry.mjs"]

FROM node:22-alpine AS worker
WORKDIR /app
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=1
COPY --from=builder /app/package.json /app/package-lock.json ./
RUN npm ci --ignore-scripts
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/src ./src
COPY --from=builder /app/drizzle ./drizzle
COPY --from=builder /app/drizzle.config.ts ./drizzle.config.ts
COPY --from=builder /app/.release-revision ./.release-revision
ENV NODE_ENV=production
ENV APP_REVISION_FILE=/app/.release-revision
CMD ["./node_modules/.bin/tsx", "scripts/run-job-worker.ts"]

# Keep a web-compatible default stage for plain `docker build` without `--target`.
FROM web AS runner
