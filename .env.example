DATABASE_URL=postgres://runtime-user:password@host/database?sslmode=require
MIGRATION_DATABASE_URL=postgres://migration-owner:password@host/database?sslmode=require
# Local-only analytics sandbox. Keep these unset in shared, CI, Dokploy, and production environments.
# The dev process requires both URL variables to be byte-for-byte identical local `analytics_sandbox` URLs.
# Sign in to the exact organization named by ANALYTICS_SANDBOX_ORG_ID.
# ANALYTICS_SANDBOX=1
# ANALYTICS_SANDBOX_DISPOSABLE=1
# ANALYTICS_SANDBOX_ORG_ID=<local-org-id>
# ANALYTICS_SANDBOX_DB_URL=postgresql://<local-user>:<local-password>@127.0.0.1/analytics_sandbox
# DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1/analytics_sandbox
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:4322
PUBLIC_SITE_URL=http://localhost:4321
LABEL_SUITE_SWEEP_ORG_ID=true-nature

# Gmail contact enrichment. Configure an OAuth web client in Google Cloud.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXTCLOUD_OIDC_CLIENT_ID=your-nextcloud-oidc-client-id
NEXTCLOUD_OIDC_CLIENT_SECRET=your-nextcloud-oidc-client-secret
# Optional. If omitted, Label Suite uses the current app origin, e.g. http://localhost:4333/api/gmail/callback.
GOOGLE_GMAIL_REDIRECT_URI=
# Optional; falls back to BETTER_AUTH_SECRET when omitted.
GMAIL_TOKEN_SECRET=replace-with-a-random-32-byte-secret

# YouTube creator discovery. Server-only API key with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=your-youtube-data-api-key

# Cloudflare R2 (S3-compatible object storage)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=label-suite
R2_PUBLIC_BASE_URL=https://media.example.com
# Dedicated non-public bucket; must be distinct from R2_BUCKET.
R2_ANALYTICS_PRIVATE_BUCKET=label-suite-private-analytics

# One-off migration source, only needed while copying existing Supabase data to Neon.
# Prefer SOURCE_DATABASE_URL when you have the old Postgres password.
SOURCE_DATABASE_URL=postgres://user:password@old-host/database
# Fallback when direct Postgres is unavailable and the old Supabase REST API is reachable.
SUPABASE_URL=http://old-supabase-host:3005
SUPABASE_SERVICE_ROLE_KEY=old-service-role-key

# Airtable
AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id
AIRTABLE_IMPORT_ORG_ID=true-nature

# Samply review and delivery integration
SAMPLY_API_TOKEN=your-samply-personal-access-token
SAMPLY_BASE_URL=https://samply.app/api/v0
SAMPLY_ORG_ID=true-nature

# Sisense/Periscope distributor analytics import
SISENSE_ORG_ID=true-nature
SISENSE_DASHBOARD_URL=https://app.periscopedata.com/shared/...
SISENSE_DASHBOARD_PASSWORD=shared-dashboard-password
SISENSE_WIDGETS_JSON=[{"key":"tracks-by-growth-rate","title":"Tracks by Growth Rate"},{"key":"spotify-superfans-active-streams-city","title":"Spotify Superfans & Active Streams by City"},{"key":"spotify-demographics-passion-indicators","title":"Spotify Demographics by Passion Indicators"},{"key":"spotify-streams-source","title":"Spotify Streams by Source"},{"key":"apple-streams-source","title":"Apple Streams by Source"},{"key":"spotify-playlist-listings","title":"Spotify Playlist Listings"},{"key":"shazams-city","title":"Shazams by City"},{"key":"passion-indicator-benchmarks-genre","title":"Passion Indicator Benchmarks by Genre"}]
SISENSE_INITIAL_DATE_RANGE=All Dates
SISENSE_RECENT_DATE_RANGE=1 Day
SISENSE_INITIAL_AGGREGATION=Daily
SISENSE_RECENT_AGGREGATION=Daily
SISENSE_RESET_FILTERS=false
SISENSE_SKIP_FILTERS=false
SISENSE_HEADLESS=true
# Optional. Use IDs when possible; names/titles require DATABASE_URL so the worker can resolve them.
SISENSE_SCOPE_ARTIST_ID=
SISENSE_SCOPE_RELEASE_ID=
SISENSE_SCOPE_TRACK_ID=
SISENSE_SCOPE_ARTIST_NAME=
SISENSE_SCOPE_RELEASE_TITLE=
SISENSE_SCOPE_TRACK_TITLE=
SISENSE_DOWNLOAD_DIR=.data/sisense
SISENSE_STORAGE_PREFIX=distributor/sisense

# Brevo (Sendinblue) email API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sender@example.com
