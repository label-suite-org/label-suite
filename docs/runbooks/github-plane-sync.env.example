# Dokploy values for the separate plane-sync application. Replace every angle-
# bracket placeholder in Dokploy only; this file intentionally contains no real
# credentials, private keys, webhook secrets, tokens, or deployment addresses.
GITHUB_REPOSITORY=label-suite-org/label-suite_neon_r2
SYNC_WRITE_MODE=dry-run
HOST=0.0.0.0
PORT=8787
HTTP_BODY_LIMIT_BYTES=1048576
PLANE_SYNC_DB_PATH=/data/plane-sync.sqlite
RECONCILE_INTERVAL_MS=900000
ENVELOPE_RETENTION_MS=604800000
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_INSTALLATION_ID=<github-app-installation-id>
GITHUB_APP_PRIVATE_KEY_B64=<single-line-base64-encoded-pem>
GITHUB_WEBHOOK_SECRET=<github-webhook-secret>
PLANE_BASE_URL=https://<plane-host>
PLANE_API_TOKEN=<plane-api-token>
PLANE_WORKSPACE=<plane-workspace-slug>
PLANE_PROJECT_ID=<plane-project-uuid>
SERVICE_REVISION_FILE=/app/.release-revision
PLANE_SYNC_APP_NAME=label-suite-plane-sync
