# Paste these into the Dokploy production environment shared variables.
# Do not commit real values. Do not put these in GitHub Actions or GitHub Secrets.

# Required application/runtime configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PUBLIC_SITE_URL=https://suite.truenature.online
BETTER_AUTH_TRUSTED_ORIGINS=https://suite.truenature.online

# Required for AI-assisted campaign research and drafting
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
# Verified against OpenRouter's model catalog on 2026-08-05 for tools and structured outputs.
OPENROUTER_COMMUNICATOR_MODEL=qwen/qwen3.6-35b-a3b

# Required for complete password-reset email delivery
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
BREVO_SENDER_EMAIL=sender@example.com

# Worker and health policy
REQUIRE_WORKER_HEALTH=true
LABEL_SUITE_WORKER_ID=label-suite-worker
LABEL_SUITE_WORKER_HEALTH_MAX_AGE_MS=45000
LABEL_SUITE_JOB_LEASE_MS=60000
LABEL_SUITE_JOB_HEARTBEAT_MS=20000
LABEL_SUITE_JOB_POLL_MS=1000
LABEL_SUITE_SWEEP_ORG_ID=true-nature
ANALYTICS_HEALTH_ORG_ID=true-nature

# Cloudflare R2 object storage. The private analytics bucket is required before
# applying a Spotify for Artists CSV import; it must not be the public media bucket.
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ENDPOINT=https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=label-suite
R2_ANALYTICS_PRIVATE_BUCKET=label-suite-private-analytics
R2_PUBLIC_BASE_URL=https://media.truenature.online

# Optional: Gmail contact enrichment
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_GMAIL_REDIRECT_URI=https://suite.truenature.online/api/gmail/callback
GMAIL_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional: on-demand YouTube creator discovery
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_DATA_API_KEY

# Optional: Samply review/delivery integration
SAMPLY_API_TOKEN=REPLACE_WITH_SAMPLY_PERSONAL_ACCESS_TOKEN
SAMPLY_BASE_URL=https://samply.app/api/v0
SAMPLY_ORG_ID=true-nature

# Optional: Airtable operator/import tooling; choose one token variable
AIRTABLE_API_KEY=REPLACE_WITH_AIRTABLE_PERSONAL_ACCESS_TOKEN
AIRTABLE_BASE_ID=REPLACE_WITH_AIRTABLE_BASE_ID
AIRTABLE_IMPORT_ORG_ID=true-nature

# Optional: Sisense/Periscope ingestion
SISENSE_ORG_ID=true-nature
SISENSE_DASHBOARD_URL=https://app.periscopedata.com/shared/REPLACE_ME
SISENSE_DASHBOARD_PASSWORD=REPLACE_IF_DASHBOARD_IS_PASSWORD_PROTECTED
SISENSE_WIDGETS_JSON=[{"key":"tracks-by-growth-rate","title":"Tracks by Growth Rate"},{"key":"spotify-superfans-active-streams-city","title":"Spotify Superfans & Active Streams by City"},{"key":"spotify-demographics-passion-indicators","title":"Spotify Demographics by Passion Indicators"},{"key":"spotify-streams-source","title":"Spotify Streams by Source"},{"key":"apple-streams-source","title":"Apple Streams by Source"},{"key":"spotify-playlist-listings","title":"Spotify Playlist Listings"},{"key":"shazams-city","title":"Shazams by City"},{"key":"passion-indicator-benchmarks-genre","title":"Passion Indicator Benchmarks by Genre"}]
SISENSE_INITIAL_DATE_RANGE=All Dates
SISENSE_RECENT_DATE_RANGE=Yesterday
SISENSE_TIME_ZONE=Europe/Copenhagen
SISENSE_INITIAL_AGGREGATION=Daily
SISENSE_RECENT_AGGREGATION=Daily
SISENSE_RESET_FILTERS=false
SISENSE_SKIP_FILTERS=false
SISENSE_HEADLESS=true
SISENSE_ACTION_TIMEOUT_MS=30000
SISENSE_DOWNLOAD_TIMEOUT_MS=300000
SISENSE_SCOPE_ARTIST_ID=
SISENSE_SCOPE_RELEASE_ID=
SISENSE_SCOPE_TRACK_ID=
SISENSE_SCOPE_ARTIST_NAME=
SISENSE_SCOPE_RELEASE_TITLE=
SISENSE_SCOPE_TRACK_TITLE=
SISENSE_PROVIDER_ARTIST_FILTER=
SISENSE_PROVIDER_TRACK_FILTER=
SISENSE_DOWNLOAD_DIR=.data/sisense
SISENSE_STORAGE_PREFIX=distributor/sisense

# APP_COMMIT_SHA intentionally does not belong here or in Dokploy configuration.
# Dokploy builds the checked-out `main` source and the image embeds that SHA in
# `.release-revision`. Keep every real runtime value above in the Dokploy
# Project/Environment. The service Environment tab may contain only its 42
# ${{project.NAME}} references; Compose then reads Dokploy's generated file.
