{
  "name": "label-suite",
  "type": "module",
  "version": "0.0.1",
  "bin": {
    "label-suite": "ops/campaign-enrichment-mcp/bin/label-suite.mjs"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test:e2e": "playwright test",
    "test:e2e:release-gate": "playwright test tests/release-gate/release-gate.spec.ts",
    "test:e2e:release-gate:campaign-enrichment": "npm run release-gate:preflight && npm run release-gate:seed && playwright test tests/release-gate/release-gate.spec.ts --grep \"campaign enrichment MCP is proposal-only\"",
    "release-gate:seed": "tsx scripts/seed-release-gate-fixtures.ts",
    "release-gate:preflight": "tsx scripts/release-gate-preflight.ts",
    "release-gate:ci": "npm run release-gate:preflight && npm run test:e2e:release-gate",
    "catalog:backfill": "tsx scripts/backfill-catalog.ts",
    "campaign:mcp": "tsx ops/campaign-enrichment-mcp/src/index.ts mcp serve",
    "campaign:enrich": "tsx ops/campaign-enrichment-mcp/src/index.ts enrich",
    "campaign:mcp:test": "vitest run ops/campaign-enrichment-mcp/src",
    "build": "astro build",
    "check": "node --max-old-space-size=2560 node_modules/astro/bin/astro.mjs check",
    "deps:ci": "node scripts/npm-ci.mjs",
    "ci": "npm test -- --maxWorkers=2 --exclude scripts/sisense-browser-contract.test.ts && npm exec vitest run scripts/sisense-browser-contract.test.ts -- --maxWorkers=1 && npm run db:check && npm run check && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "seed": "tsx src/lib/seed.ts",
    "sweep": "tsx scripts/run-sweep.ts",
    "jobs:work": "tsx scripts/run-job-worker.ts",
    "jobs:schedule": "tsx scripts/enqueue-scheduled-jobs.ts",
    "sisense:sync": "tsx scripts/sisense-sync.ts",
    "sisense:scrape": "tsx scripts/sisense-sync.ts --mode scrape",
    "sisense:import": "tsx scripts/sisense-sync.ts --mode import",
    "sisense:diagnostic": "tsx scripts/sisense-diagnostic-controller-cli.ts",
    "test:analytics-ingestion-fixture": "tsx scripts/analytics-ingestion-fixture.ts",
    "test:spotify-analytics-import": "tsx scripts/spotify-analytics-import-fixture.ts",
    "test:sisense-track-snapshot-import": "tsx scripts/sisense-track-snapshot-import-fixture.ts",
    "analytics:sandbox:seed": "tsx scripts/seed-analytics-sandbox.ts",
    "test:analytics-sandbox-fixture": "tsx scripts/analytics-sandbox-integration-fixture.ts",
    "images:optimize": "tsx scripts/optimize-r2-images.ts",
    "samply:smoke": "tsx scripts/samply-smoke.ts",
    "airtable:parity": "tsx scripts/airtable-parity.ts",
    "m0:parity": "tsx scripts/m0-parity-audit.ts",
    "m0:approve": "tsx scripts/m0-approved-dispositions.ts",
    "airtable:import": "tsx scripts/airtable-import.ts",
    "airtable:grants:parity": "tsx scripts/airtable-parity.ts --grants-v2",
    "airtable:grants:import": "tsx scripts/airtable-import.ts --grants-v2",
    "grants:money-model": "tsx scripts/grants-money-model.ts",
    "airtable:copy-assets": "tsx scripts/airtable-copy-assets.ts",
    "issue50:parity": "tsx scripts/issue50-artist-relationship-parity.ts",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "royalty:runtime-db-preflight": "tsx scripts/verify-royalty-runtime-db-role.ts --preflight",
    "royalty:runtime-db-postflight": "tsx scripts/verify-royalty-runtime-db-role.ts --postflight",
    "royalty:runtime-db-grants": "tsx scripts/provision-royalty-runtime-db-access.ts",
    "db:migrate:runtime-safe": "tsx scripts/run-royalty-runtime-safe-migration.ts",
    "repo:inventory": "node scripts/repository-inventory.mjs",
    "db:schema-contract": "tsx scripts/schema-contract.ts capture",
    "db:drift-check": "tsx scripts/schema-contract.ts check",
    "db:policy-check": "tsx scripts/schema-contract.ts policy-check",
    "db:manifest-check": "tsx scripts/schema-contract.ts manifest-check",
    "db:verify-legacy": "node scripts/verify-integration-core-legacy.mjs",
    "deploy:check": "node scripts/dokploy-deploy-contract.mjs",
    "deploy:ingress-probe": "bash scripts/probe-dokploy-webhook-ingress.sh",
    "migrate:data": "node scripts/migrate-data.mjs",
    "plane-sync:test": "vitest run ops/plane-sync",
    "plane-sync:build": "tsc -p ops/plane-sync/tsconfig.json",
    "plane-sync:delivery-contract": "node scripts/verify-plane-sync-delivery.mjs",
    "plane-sync:reconcile": "node ops/plane-sync/dist/cli.js reconcile --dry-run",
    "plane-sync:bootstrap": "node ops/plane-sync/dist/cli.js bootstrap --dry-run",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "storybook:build": "storybook build",
    "storybook:test": "LABEL_SUITE_STORYBOOK_TEST=1 vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/passkey": "1.6.25",
    "@fontsource-variable/geist": "^5.2.9",
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/hashes": "1.8.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "10.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "openai": "^7.4.0",
    "pdf-parse": "2.4.5",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@airtable/mcp-cli": "0.2.6",
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^26.0.0",
    "@vitest/browser-playwright": "4.1.9",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^27.4.0",
    "storybook": "10.6.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "yaml": "^2.9.0"
  }
}
