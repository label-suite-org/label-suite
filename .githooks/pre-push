#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    printf '%s\n' \
      "Direct pushes to main are blocked." \
      "Push a feature branch and merge it through a reviewed pull request." >&2
    exit 1
  fi
done
