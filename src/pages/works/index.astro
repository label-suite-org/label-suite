---
import AppLayout from "../../layouts/AppLayout.astro";
import { listWorkPriorities } from "../../server/works";
import { WorkCreateDialog } from "../../components/works/WorkActionButtons";
import { WorksList } from "../../components/works/WorksList";
import { serializeClientCapabilities } from "../../server/tenant";

const orgId = Astro.locals.orgId!;
const workRows = await listWorkPriorities(orgId);
const canMutate = serializeClientCapabilities(Astro.locals.membershipRole ?? "member")["operations.mutate"];
---

<AppLayout>
  <div class="space-y-6">
    <h1 class="text-base font-semibold md:sr-only">Works</h1>
    {!workRows.length ? (
      <div class="py-12 text-center text-muted-foreground">
        <p class="text-base font-medium">No works yet.</p>
        <div class="mt-5 flex justify-center">
          {canMutate ? <WorkCreateDialog client:load /> : <p class="text-sm">Read-only for your role</p>}
        </div>
      </div>
    ) : (
      <WorksList client:load works={workRows} canMutate={canMutate} />
    )}
  </div>
</AppLayout>
