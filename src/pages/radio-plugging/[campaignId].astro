---
import AppLayout from "../../layouts/AppLayout.astro";
import { RadioPluggingCockpit } from "../../components/radio-plugging/RadioPluggingCockpit";
import { listRadioStations } from "../../server/radio-stations";
import { getRadioPluggingCampaign, listRadioPluggingCampaigns } from "../../server/radio-plugging";
import { serializeClientCapabilities } from "../../server/tenant";

const { campaignId } = Astro.params;
if (!campaignId) return Astro.redirect("/radio-plugging");

const orgId = Astro.locals.orgId!;
const campaigns = await listRadioPluggingCampaigns(orgId);
const current = await getRadioPluggingCampaign(orgId, campaignId);
const allStations = await listRadioStations(orgId);
const canMutate = serializeClientCapabilities(Astro.locals.membershipRole ?? "member")["operations.mutate"];
---

<AppLayout>
  <div class="space-y-6">
    <div class="text-sm">
      <a href="/radio-plugging" class="text-sm text-muted-foreground hover:text-foreground">← Radio Plugging</a>
    </div>

    <RadioPluggingCockpit client:load campaigns={campaigns} current={current} allStations={allStations} canMutate={canMutate} />
  </div>
</AppLayout>
