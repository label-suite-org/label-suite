---
import "../../../styles/global.css";
import { runWithDatabaseContext } from "../../../lib/db";
import { getPublicPitch } from "../../../server/pitches";
export const prerender = false;
const { org, token } = Astro.params;
if (!org || !/^[A-Za-z0-9_-]+$/.test(org) || !token || !/^[a-f0-9]{64}$/.test(token)) return new Response("Not found", { status: 404 });
const pitch = await runWithDatabaseContext({ userId: "pitch-listener", orgId: org }, () => getPublicPitch(org, token));
if (!pitch) return new Response("This listening link is unavailable.", { status: 404 });
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>{pitch.title}</title></head>
<body class="bg-background text-foreground"><main class="mx-auto max-w-3xl space-y-8 px-5 py-12">
  <header class="flex items-center gap-5">
    {pitch.artwork_url && <img src={pitch.artwork_url} alt="" class="size-24 rounded-lg object-cover" referrerpolicy="no-referrer"/>}
    <div><p class="text-muted-foreground">{pitch.artist_name}</p><h1 class="text-3xl font-semibold">{pitch.title}</h1></div>
  </header>
  {pitch.message && <p class="whitespace-pre-wrap">{pitch.message}</p>}
  <iframe title={`Listen to ${pitch.title}`} src={pitch.embed_url} class="h-[480px] w-full rounded-lg border" allow="autoplay" referrerpolicy="no-referrer"></iframe>
  {pitch.download_url && <p><a class="font-medium underline" href={pitch.download_url} target="_blank" rel="noopener noreferrer">Download recordings in Samply ↗</a></p>}
  <section><h2 class="text-lg font-semibold">Recordings</h2><ol class="mt-3 space-y-3">{pitch.recordings.map(file => <li><strong>{file.title}</strong><p class="text-sm text-muted-foreground">{file.file_name}{file.isrc ? ` · ISRC ${file.isrc}` : ""}</p></li>)}</ol></section>
  {pitch.credits && <section><h2 class="text-lg font-semibold">Credits</h2><p class="whitespace-pre-wrap">{pitch.credits}</p></section>}
  {pitch.rights_note && <section><h2 class="text-lg font-semibold">Rights information</h2><p class="whitespace-pre-wrap">{pitch.rights_note}</p></section>}
  <footer class="space-y-2 border-t pt-5 text-sm"><a class="underline" href={`mailto:${pitch.reply_email}`}>Contact {pitch.reply_email}</a><p class="text-muted-foreground">{pitch.downloads ? "Downloads are enabled." : "Listening only; downloads are disabled."} Listening and delivery are provided by Samply.</p></footer>
</main></body></html>
