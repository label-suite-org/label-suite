---
import "../styles/global.css";
import { ResetPasswordForm } from "../components/auth/ResetPasswordForm";

const token = Astro.url.searchParams.get("token");
const callbackError = Astro.url.searchParams.get("error");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Label Suite — Reset Password</title>
  </head>
  <body class="min-h-screen bg-background flex items-center justify-center antialiased">
    <ResetPasswordForm client:load token={token} callbackError={callbackError} />
  </body>
</html>
