---
import AppLayout from "../layouts/AppLayout.astro";
import GrantsFundingCockpit from "../components/grants/GrantsFundingCockpit";
import { getGrantsWorkspace } from "../server/grants-workspace";
import { getGrantsWorklist } from "../server/grants-worklist";
import { serializeClientCapabilities } from "../server/tenant";
const initialGrantId = Astro.url.searchParams.get("grant");
const orgId = Astro.locals.orgId!;
const currentUserName = Astro.locals.user?.name ?? null;
const capabilities = serializeClientCapabilities(Astro.locals.membershipRole ?? "member");
const initialNewApplicationProjectId = Astro.url.searchParams.get("newApplicationProjectId");
const [workspace, initialWorklist] = await Promise.all([getGrantsWorkspace(orgId), getGrantsWorklist(orgId)]);
---
<AppLayout><GrantsFundingCockpit client:load initialGrantId={initialGrantId} workspace={workspace} initialWorklist={initialWorklist} initialNewApplicationProjectId={initialNewApplicationProjectId} currentUserName={currentUserName} canMutate={capabilities["fundraising.mutate"]} /></AppLayout>
