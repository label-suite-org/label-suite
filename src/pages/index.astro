---
import AuthLayout from "../layouts/AuthLayout.astro";
import { LoginForm } from "../components/auth/LoginForm";
export const prerender = false;
const ssoEnabled = Boolean(process.env.POCKET_ID_OIDC_CLIENT_ID && process.env.POCKET_ID_OIDC_CLIENT_SECRET);
---
<AuthLayout>
  <LoginForm client:load ssoEnabled={ssoEnabled} />
</AuthLayout>
