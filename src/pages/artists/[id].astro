---
import AppLayout from "../../layouts/AppLayout.astro";
import { getArtistDetail } from "../../server/artists";
import { emptyAnalyticsSummary, getArtistSisenseSection, listAnalyticsSummary } from "../../server/analytics";
import { listContactOptions } from "../../server/contacts";
import AnalyticsPanel from "../../components/analytics/AnalyticsPanel.astro";
import ArtistSisensePanel from "../../components/analytics/ArtistSisensePanel";
import { ArtistWorkspace } from "../../components/artists/ArtistWorkspace";
import type { ArtistFocusField } from "../../components/artists/ArtistForm";
import type { ReadinessDestination } from "../../components/artists/artist-readiness";
import { serializeClientCapabilities } from "../../server/tenant";

const { id } = Astro.params;
if (!id) return Astro.redirect("/artists");

const orgId = Astro.locals.orgId!;
const canMutate = serializeClientCapabilities(Astro.locals.membershipRole ?? "member")["operations.mutate"];
const {
  artist,
  releases: releaseRows,
  mediaAssets,
  campaigns,
  documents,
  rights,
  tasks,
  primaryContact,
} = await getArtistDetail(orgId, id);
const contactOptions = canMutate ? await listContactOptions(orgId) : [];
const tabParam = Astro.url.searchParams.get("tab");
const focusParam = Astro.url.searchParams.get("focus");
const destinationParam = Astro.url.searchParams.get("destination");
const initialTab = tabParam && ["overview", "visuals", "releases", "team", "rights", "campaigns", "analytics"].includes(tabParam)
  ? tabParam as "overview" | "visuals" | "releases" | "team" | "rights" | "campaigns" | "analytics"
  : undefined;
const initialFocusField = canMutate && focusParam && ["bio", "pro", "ipi", "spotify_id", "spotify_followers", "spotify_popularity", "instagram", "tiktok"].includes(focusParam)
  ? focusParam as ArtistFocusField
  : undefined;
const initialReadinessDestination = destinationParam && ["overview:bio", "overview:pro", "overview:ipi", "overview:spotify_id", "overview:spotify_followers", "overview:spotify_popularity", "overview:instagram", "overview:tiktok", "tab:visuals", "tab:documents", "tab:rights"].includes(destinationParam)
  ? destinationParam as ReadinessDestination
  : undefined;
const analytics = artist
  ? await listAnalyticsSummary(orgId, { artistId: id })
  : emptyAnalyticsSummary();
const sisense = artist ? await getArtistSisenseSection(orgId, id) : null;
---

<AppLayout>
  {!artist ? <p class="text-muted-foreground">Artist not found.</p> : (
    <div class="space-y-8">
      {canMutate && <div class="flex justify-end"><a href={`/artists/${encodeURIComponent(id)}/portal`} class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted">Artist archive & form</a></div>}
      <ArtistWorkspace
        client:load
        artist={artist}
        releases={releaseRows}
        assets={mediaAssets}
        campaigns={campaigns}
        documents={documents}
        rights={rights}
        tasks={tasks}
        primaryContact={primaryContact}
        contactOptions={contactOptions}
        canMutate={canMutate}
        initialTab={initialTab}
        initialFocusField={initialFocusField}
        initialReadinessDestination={initialReadinessDestination}
      />

      <AnalyticsPanel analytics={analytics} />

      {sisense && <ArtistSisensePanel client:load section={sisense} />}
    </div>
  )}
</AppLayout>
