---
import AppLayout from "../../layouts/AppLayout.astro";
import { listArtistRoster } from "../../server/artists";
import { ArtistCreateDialog } from "../../components/artists/ArtistCreateDialog";
import { ArtistRoster } from "../../components/artists/ArtistRoster";
import { listContactOptions } from "../../server/contacts";
import { serializeClientCapabilities } from "../../server/tenant";

const orgId = Astro.locals.orgId!;
const artistRows = await listArtistRoster(orgId);
const canMutate = serializeClientCapabilities(Astro.locals.membershipRole ?? "member")["operations.mutate"];
const contactOptions = canMutate ? await listContactOptions(orgId) : [];
---

<AppLayout>
  <div class="space-y-6">
    <h1 class="text-base font-semibold md:sr-only">Artists</h1>

    {!artistRows.length ? (
      <div class="py-12 text-center text-muted-foreground">
        <p class="text-base font-medium text-foreground">No artists yet.</p>
        <p class="mt-1 text-sm">Create the first roster profile to connect releases, assets, campaigns, and royalty records.</p>
        {canMutate && <div class="mt-5 flex justify-center">
          <ArtistCreateDialog client:load contactOptions={contactOptions} />
        </div>}
      </div>
    ) : (
      <ArtistRoster client:load artists={artistRows} contactOptions={contactOptions} canMutate={canMutate} />
    )}
  </div>
</AppLayout>
