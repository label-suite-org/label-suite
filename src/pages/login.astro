---
import AuthLayout from "../layouts/AuthLayout.astro";
import { LoginForm } from "../components/auth/LoginForm";
export const prerender = false;
const ssoEnabled = Boolean(process.env.NEXTCLOUD_OIDC_CLIENT_ID && process.env.NEXTCLOUD_OIDC_CLIENT_SECRET);
---
<AuthLayout title="Suite — Sign in">
  <LoginForm client:load ssoEnabled={ssoEnabled} />
</AuthLayout>
