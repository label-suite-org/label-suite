---
import { HttpError } from "../../server/errors";
import AppLayout from "../../layouts/AppLayout.astro";
import { SyncList } from "../../components/sync/SyncWorkspace";
import { listSyncDealsPage } from "../../server/sync";
import { requireCapability } from "../../server/tenant";
if (!Astro.locals.user) return Astro.redirect("/login");
if (!["owner","operator"].includes(Astro.locals.membershipRole??"")) return new Response("Sync is available to workspace owners and operators.",{status:403});
const orgId=requireCapability(Astro.locals,"operations.mutate");
const artist=Astro.url.searchParams.get("artist")??undefined;
const release=Astro.url.searchParams.get("release")??undefined;
let page;
try {
  page=await listSyncDealsPage(orgId,{limit:25,cursor:Astro.url.searchParams.get("cursor")??undefined,artist,release});
} catch (error) {
  if (error instanceof HttpError) return new Response(error.message,{status:error.status});
  throw error;
}
const next=page.next_cursor ? `/sync?${new URLSearchParams({...(artist?{artist}:{}),...(release?{release}:{}),cursor:page.next_cursor})}` : undefined;
---
<AppLayout><SyncList items={page.items} artistId={artist} releaseId={release} nextPageHref={next}/></AppLayout>
