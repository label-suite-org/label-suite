---
import AppLayout from "../../layouts/AppLayout.astro";
import { SyncEditor } from "../../components/sync/SyncWorkspace";
import { getSyncDeal,syncOptions } from "../../server/sync";
import { requireCapability } from "../../server/tenant";
if (!Astro.locals.user) return Astro.redirect("/login");
if (!["owner","operator"].includes(Astro.locals.membershipRole??"")) return new Response("Sync is available to workspace owners and operators.",{status:403});
const orgId=requireCapability(Astro.locals,"operations.mutate");
const id=Astro.params.id!;
const initial=id==="new"?null:await getSyncDeal(orgId,id);
const options=await syncOptions(orgId);
---
<AppLayout><SyncEditor client:load initial={initial} options={options} artistId={Astro.url.searchParams.get("artist")??""} releaseId={Astro.url.searchParams.get("release")??""}/></AppLayout>
