---
import { serializeClientCapabilities } from "../../server/tenant";
import AppLayout from "../../layouts/AppLayout.astro";
import ProjectsEventsWorkspace from "../../components/projects/ProjectsEventsWorkspace";
import { listArtistOptions } from "../../server/artists";
import { listContactOptions } from "../../server/contacts";
import { listProjects } from "../../server/projects";
import { listProjectEvents } from "../../server/project-events";
import { listReleaseOptions } from "../../server/releases";

const canMutate = serializeClientCapabilities(Astro.locals.membershipRole ?? "member")["projects.mutate"];
const orgId = Astro.locals.orgId!;
const [projects, events, artists, releases, contacts] = await Promise.all([
  listProjects(orgId), listProjectEvents(orgId, {}), listArtistOptions(orgId), listReleaseOptions(orgId), listContactOptions(orgId),
]);
const initialView = Astro.url.searchParams.get("view") === "events" ? "events" : "projects";
---

<AppLayout title="Projects">
  <ProjectsEventsWorkspace client:load canMutate={canMutate} projects={projects} events={events} artists={artists} releases={releases} contacts={contacts} initialView={initialView} workspaceRoute="projects" />
</AppLayout>
