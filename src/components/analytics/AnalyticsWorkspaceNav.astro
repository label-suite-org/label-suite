---
import {
  ANALYTICS_SECTIONS,
  analyticsSectionHref,
  type AnalyticsSection,
} from "../../lib/analytics-workspace";

interface Props {
  activeSection: AnalyticsSection;
  currentUrl: URL;
}

const { activeSection, currentUrl } = Astro.props;
---

<nav aria-label="Analytics sections" class="overflow-x-auto border-b border-[var(--border)]">
  <ul class="m-0 flex min-w-max list-none gap-1 p-0">
    {ANALYTICS_SECTIONS.map((section) => (
      <li>
        <a
          href={analyticsSectionHref(section.id, currentUrl)}
          aria-current={section.id === activeSection ? "page" : undefined}
          class:list={[
            "block border-b-2 px-3 py-3 text-sm font-medium transition-colors",
            section.id === activeSection
              ? "border-[var(--foreground)] text-[var(--foreground)]"
              : "border-transparent text-[var(--muted-foreground)] hover:text-[var(--foreground)]",
          ]}
        >
          {section.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
